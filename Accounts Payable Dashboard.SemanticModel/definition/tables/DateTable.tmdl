	partition DateTable = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(AP_Data[Invoice Date]),
				        MAX(AP_Data[Due Date])
				    ),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Year Month", FORMAT([Date], "YYYY-MM"),
				    "Quarter", "Q" & FORMAT([Date], "Q")
				)

	annotation PBI_Id = 9922610e2045442e8b32f8fef556ce80

